{
  "name": "@signalk/freeboard-sk",
  "version": "3.4.0-beta.1",
  "description": "Openlayers chart plotter implementation for Signal K",
  "keywords": [
    "signalk-webapp",
    "signalk-node-server-plugin",
    "signalk-category-chart-plotters"
  ],
  "files": [
    "plugin",
    "public",
    "assets/icons/icon-192x192.png",
    "docs/screenshots",
    "CHANGELOG.md"
  ],
  "signalk": {
    "displayName": "Freeboard-SK",
    "appIcon": "assets/icons/icon-192x192.png",
    "screenshots": [
      "./docs/screenshots/1_freeboard-sk.png",
      "./docs/screenshots/2_freeboard-sk.jpg",
      "./docs/screenshots/3_freeboard-sk.jpg"
    ],
    "recommends": [
      "signalk-charts-provider-simple",
      "@signalk/tracks-plugin",
      "signalk-buddylist-plugin",
      "signalk-instrument-widgets",
      "signalk-symbol-manager",
      "@signalk/open-meteo-provider",
      "signalk-basic-tide-widgets",
      "signalk-restricted-areas",
      "@marineyachtradar/signalk-plugin",
      "signalk-flags",
      "hoekens-anchor-alarm",
      "signalk-collision-alerts",
      "signalk-target-fusion"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "repository": "https://github.com/SignalK/freeboard-sk",
  "type": "module",
  "main": "plugin/index.js",
  "signalk-plugin-enabled-by-default": true,
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/build-features.mts",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "eslint .",
    "format": "prettier --ignore-path .gitignore --write \"src/**/*.+(ts|html)\"",
    "format:check": "prettier --ignore-path .gitignore --check \"src/**/*.+(ts|html)\"",
    "format:helper": "prettier --ignore-path .gitignore --write \"helper/**/*.+(ts|html)\"",
    "format:all": "npm run format && npm run format:helper",
    "build:helper": "tsc -p tsconfig-helper.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck:workers": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:helper": "tsc -p tsconfig-helper.spec.json",
    "typecheck:strict": "node scripts/check-strict.mts",
    "build:features": "node scripts/build-features.mts",
    "prebuild:web": "node scripts/build-features.mts",
    "build:web": "node scripts/build-web.mts",
    "build:sit": "ng build -c development --aot",
    "build:all": "npm run typecheck:tools && npm run typecheck:workers && npm run typecheck:helper && npm run typecheck:strict && npm run build:helper && npm run build:web",
    "build:prod": "npm run build:all",
    "prepack": "npm run build:all",
    "test:ci": "node scripts/test-ci.mts",
    "test:tools": "tsc -p dev-tools/changelog && vitest run --config dev-tools/changelog/vitest.config.mts",
    "test:helper": "vitest run --config helper/vitest.config.mts",
    "version": "node dev-tools/changelog/index.mts stamp && git add features/changelog.json"
  },
  "author": "AdrianP",
  "contributors": [
    {
      "name": "panaaj@hotmail.com"
    },
    {
      "name": "robert@42.co.nz"
    }
  ],
  "license": "Apache-v2",
  "dependencies": {
    "@signalk/server-api": "^2.24.0",
    "geolib": "^3.3.3",
    "google-protobuf": "^4.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "signalk-plotterext-bus": "^0.23.0",
    "tslib": "^2.0.0",
    "typebox": "^1.3.36",
    "unified": "^11.0.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/build": "^21.2.25",
    "@angular/cdk": "^21.0.3",
    "@angular/cli": "^21.2.25",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/language-service": "^21.2.25",
    "@angular/material": "^21.0.3",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@eslint/js": "^10.0.1",
    "@kolkov/angular-editor": "^3.0.5",
    "@maplibre/maplibre-gl-style-spec": "^23.3.0",
    "@types/arcgis-rest-api": "^10.4.5",
    "@types/express": "^4.17.17",
    "@types/geojson": "^7946.0.10",
    "@types/google-protobuf": "^3.15.12",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.8.0",
    "@types/topojson-specification": "^1.0.2",
    "@types/xml2js": "^0.4.14",
    "@vitest/web-worker": "^4.0.18",
    "baseline-browser-mapping": "^2.9.18",
    "buffer": "^6.0.3",
    "eslint": "^10.5.0",
    "events": "^3.3.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "^21.0.0",
    "ngeohash": "^0.6.3",
    "ngx-remark": "^0.2.2",
    "ol": "^10.7.0",
    "ol-mapbox-style": "^12.3.5",
    "pmtiles": "^4.4.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "proj4": "2.22.0",
    "remark": "^15.0.1",
    "rxjs": "~7.8.2",
    "semver": "^7.6.0",
    "signalk-client-angular": "^2.1.0",
    "simplify-ts": "^1.0.2",
    "stream": "^0.0.3",
    "string_decoder": "^1.3.0",
    "timers": "^0.1.1",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.18",
    "xml2js": "^0.6.2",
    "zone.js": "~0.16.2"
  }
}
